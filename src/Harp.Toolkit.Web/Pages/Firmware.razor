@page "/firmware"
@using System.Runtime.Versioning
@using Bonsai.Harp
@using Harp.Toolkit.Firmware
@using Harp.Toolkit.Firmware.Pico
@using Harp.WebUsb
@using Microsoft.AspNetCore.Components.Forms
@attribute [SupportedOSPlatform("browser")]
@implements IDisposable
@inject DeviceSession Session

<PageTitle>Firmware · Harp.Toolkit</PageTitle>

<main class="workflow-page">
    @if (!Session.IsSupported)
    {
        <div class="workspace"><UnsupportedBrowser /></div>
    }
    else
    {
        <div class="workflow">
            <header class="workflow-header">
                <h1>Update firmware</h1>
                <p>Installs a firmware release on a Harp device over USB: a <code>.hex</code> file on an ATxmega device, or a <code>.uf2</code> file on a Pico (RP2040 or RP2350) device. The device restarts into its bootloader during the update.</p>
            </header>

            <ol class="steps">
                @* Step 1: the device *@
                <li class="step @StepClass(1)">
                    <div class="step-marker" aria-hidden="true">@StepMarker(1)</div>
                    <div class="step-body">
                        <div class="step-title">
                            <h2>Connect the device</h2>
                            @if (DeviceReady && !updating && result is null)
                            {
                                <button class="link-button" @onclick="ChangeDeviceAsync">Change</button>
                            }
                        </div>
                        @if (Session.IsConnected && Session.Identity is { } identity)
                        {
                            <p class="step-summary">
                                <strong>@identity.DisplayName</strong> · firmware @identity.FirmwareVersion · hardware @identity.HardwareVersion
                                @if (identity.SerialNumber is { } serial)
                                {
                                    <text> · SN @serial.ToString("x4")</text>
                                }
                            </p>
                        }
                        else if (CurrentStep == 4 && updatedDevice is not null)
                        {
                            <p class="step-summary">@updatedDevice</p>
                        }
                        else if (bootselMode)
                        {
                            <p class="step-summary">
                                <strong>Device in BOOTSEL mode</strong> · picked over USB when the update starts
                                <button class="link-button" @onclick="() => bootselMode = false">Connect over serial instead</button>
                            </p>
                        }
                        else if (recovery && Session.Port is not null)
                        {
                            <p class="step-summary">
                                <strong>@Session.PortLabel</strong> · not answering, updating without checking the device
                                <button class="link-button" @onclick="() => recovery = false">Try connecting instead</button>
                            </p>
                        }
                        else if (CurrentStep == 1)
                        {
                            <p class="hint">Plug the device in over USB, then pick its serial port.</p>
                            <div class="row">
                                <button class="btn btn-primary" disabled="@(Session.State is SessionState.Connecting or SessionState.Busy)" @onclick="Session.SelectPortAsync">
                                    @Icons.Plug @(Session.Port is null ? "Select port" : "Select another port")
                                </button>
                                @if (Session.Port is not null)
                                {
                                    <button class="btn" disabled="@(Session.State != SessionState.Disconnected)" @onclick="Session.ConnectAsync">
                                        @(Session.State == SessionState.Connecting ? "Connecting…" : $"Connect to {Session.PortLabel}")
                                    </button>
                                }
                            </div>
                            @if (Session.Error is { } error)
                            {
                                <div class="status-line status-error" role="alert">@Icons.Error <span>@error</span></div>
                            }
                            @if (Session.Port is not null && Session.State == SessionState.Disconnected)
                            {
                                <p class="hint">
                                    Device not answering? After a failed update it can stay in its bootloader, where it cannot connect.
                                    <button class="link-button" @onclick="() => recovery = true">Update it anyway</button>
                                </p>
                            }
                            @if (Session.IsUsbSupported)
                            {
                                <p class="hint">
                                    Pico device in BOOTSEL mode, showing up as a USB drive with no serial port?
                                    <button class="link-button" @onclick="EnterBootselMode">Update a device in BOOTSEL mode</button>
                                </p>
                            }
                        }
                    </div>
                </li>

                @* Step 2: the file *@
                <li class="step @StepClass(2)">
                    <div class="step-marker" aria-hidden="true">@StepMarker(2)</div>
                    <div class="step-body">
                        <div class="step-title">
                            <h2>Choose the firmware file</h2>
                            @if (firmware is not null && CurrentStep > 2 && !updating && result is null)
                            {
                                <button class="link-button" @onclick="ClearFile">Change</button>
                            }
                        </div>
                        @if (firmware is not null && CurrentStep > 2)
                        {
                            <p class="step-summary">
                                @if (firmware.Metadata is { } metadata)
                                {
                                    <strong>@metadata.DeviceName @metadata.FirmwareVersion</strong>
                                    <text> · for hardware @metadata.HardwareVersion</text>
                                }
                                else
                                {
                                    <strong>Unknown firmware</strong>
                                    <text> · device not checked</text>
                                }
                                @if (firmware is PicoFirmwareFile pico)
                                {
                                    <text> · @pico.Targets</text>
                                }
                                · <span class="detail">@firmware.FileName</span>
                            </p>
                        }
                        else if (CurrentStep == 2)
                        {
                            <label class="dropzone">
                                <InputFile accept="@(bootselMode ? ".uf2" : ".hex,.uf2")" OnChange="OnFileSelectedAsync" />
                                @Icons.Upload
                                @if (bootselMode)
                                {
                                    <span><strong>Choose a .uf2 file</strong> or drop it here</span>
                                }
                                else
                                {
                                    <span><strong>Choose a .hex or .uf2 file</strong> or drop it here</span>
                                }
                                <small>ATxmega devices take <code>.hex</code> files and Pico devices <code>.uf2</code> files. Harp release files are named like <code>Behavior-fw1.2-harp1.13-hw2.0-ass0.hex</code>; the name says which device and hardware they are for.</small>
                            </label>
                            @if (fileError is not null)
                            {
                                <div class="status-line status-error" role="alert">@Icons.Error <span>@fileError</span></div>
                            }
                            @if (unnamedFile is not null)
                            {
                                <p class="hint">
                                    The file is a valid image. You can still install it, but the page cannot check that it is for this device.
                                    <button class="link-button" @onclick="UseUnnamedFile">Install it anyway</button>
                                </p>
                            }
                        }
                    </div>
                </li>

                @* Step 3: confirmation *@
                <li class="step @StepClass(3)">
                    <div class="step-marker" aria-hidden="true">@StepMarker(3)</div>
                    <div class="step-body">
                        <div class="step-title"><h2>Confirm the update</h2></div>
                        @if (CurrentStep == 3 && firmware is not null)
                        {
                            <div class="version-change">
                                <div>
                                    <span class="label">Installed</span>
                                    <strong>@(Session.Identity?.FirmwareVersion?.ToString() ?? "unknown")</strong>
                                </div>
                                <span class="arrow" aria-hidden="true">→</span>
                                <div>
                                    <span class="label">New</span>
                                    <strong>@(firmware.Metadata?.FirmwareVersion?.ToString() ?? "unknown")</strong>
                                </div>
                            </div>

                            @switch (Compatibility)
                            {
                                case Fit.Supported:
                                    <div class="status-line status-ok">@Icons.Check <span>Made for this device and hardware version.</span></div>
                                    break;
                                case Fit.Unsupported:
                                    <div class="status-line status-error">@Icons.Error <span>This file is for @firmware.Metadata?.DeviceName with hardware @firmware.Metadata?.HardwareVersion, but the device is @Session.Identity?.DisplayName with hardware @Session.Identity?.HardwareVersion. Installing it can leave the device unusable until the right firmware is installed.</span></div>
                                    <label class="field check">
                                        <input type="checkbox" @bind="overrideCheck" />
                                        <span>Install it anyway</span>
                                    </label>
                                    break;
                                case Fit.UnknownFile:
                                    <div class="status-line status-warn">@Icons.Warning <span>The file name does not say which device and hardware it is for, so the device was not checked. Make sure this file is for @(Session.Identity?.DisplayName ?? "this device")@(firmware is PicoFirmwareFile ? ". The update still checks that the image is for the microcontroller of the device." : ".")</span></div>
                                    break;
                                default:
                                    <div class="status-line status-warn">@Icons.Warning <span>The device was not checked. Make sure this file is for @firmware.Metadata?.DeviceName hardware @firmware.Metadata?.HardwareVersion.</span></div>
                                    break;
                            }
                            @if (VersionNote is { } note)
                            {
                                <p class="hint">@note</p>
                            }
                            @if (firmware.Metadata?.DeviceName == Harp.Toolkit.Firmware.SoundCard.Coprocessor.DeviceName)
                            {
                                <div class="status-line status-warn">@Icons.Warning <span>This page updates only the main processor of the SoundCard. Install the coprocessor image of the same release with <code>harp.toolkit update</code>, which updates both processors together.</span></div>
                            }
                            @if (firmware is PicoFirmwareFile picoFirmware)
                            {
                                <p class="hint">
                                    The device restarts in BOOTSEL mode, where it shows up as a USB drive for a moment.
                                    The first time, the browser asks you to pick it: choose <strong>RP2 Boot</strong> (RP2040) or <strong>RP2350 Boot</strong>.
                                </p>
                                @if (picoFirmware.TargetsRP2040 && UsbDevices.IsWindows)
                                {
                                    <div class="status-line status-warn">@Icons.Warning <span>On Windows, the RP2040 boot interface needs the WinUSB driver, installed once per computer. Without it the update stops with the device in BOOTSEL mode and its previous firmware still installed.</span></div>
                                    <BootselSetupHelp />
                                }
                            }

                            <label class="field check confirm">
                                <input type="checkbox" @bind="confirmed" />
                                <span>I understand the device restarts, and must stay plugged in with this page open until the update finishes.</span>
                            </label>
                            <div class="row">
                                <button class="btn btn-primary" disabled="@(!CanStart)" @onclick="UpdateAsync">@Icons.Upload Update firmware</button>
                            </div>
                        }
                    </div>
                </li>

                @* Step 4: the update *@
                <li class="step @StepClass(4)">
                    <div class="step-marker" aria-hidden="true">@StepMarker(4)</div>
                    <div class="step-body">
                        <div class="step-title"><h2>Update</h2></div>
                        @if (CurrentStep == 4)
                        {
                            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(progress?.Percent ?? 0)">
                                <div class="@(resultError ? "failed" : null)" style="width: @(progress?.Percent ?? 0)%"></div>
                            </div>
                            <ul class="stages">
                                @foreach (var (stage, label) in Stages)
                                {
                                    <li class="@StageClass(stage)">@label</li>
                                }
                            </ul>
                            @if (bootselPrompt is not null)
                            {
                                <div class="status-line status-warn" role="alert">
                                    @Icons.Plug
                                    <span>
                                        Select the device in BOOTSEL mode so the page can write to it. It is listed as <strong>RP2 Boot</strong> (RP2040) or <strong>RP2350 Boot</strong>.
                                    </span>
                                </div>
                                <div class="row">
                                    <button class="btn btn-primary" @onclick="SelectBootselDeviceAsync">@Icons.Plug Select the device</button>
                                    <button class="btn" @onclick="() => bootselPrompt?.TrySetResult(null)">It is not listed</button>
                                </div>
                            }
                            else if (updating)
                            {
                                <p class="hint">Keep the device plugged in and this page open.</p>
                            }
                            @if (result is not null)
                            {
                                <div class="status-line @(resultError ? "status-error" : "status-ok")" role="status">
                                    @(resultError ? Icons.Error : Icons.Check) <span>@result</span>
                                </div>
                                @if (showSetupHelp)
                                {
                                    <BootselSetupHelp Open="true" />
                                }
                                <div class="row">
                                    @if (resultError)
                                    {
                                        <button class="btn btn-primary" @onclick="Retry">Try again</button>
                                    }
                                    <button class="btn" @onclick="StartOver">Update another device</button>
                                </div>
                            }
                        }
                    </div>
                </li>
            </ol>
        </div>
    }
</main>

@code {
    const long MaxFileSize = 4 * 1024 * 1024;

    enum Fit { Supported, Unsupported, Unchecked, UnknownFile }

    static readonly (UpdateStage Stage, string Label)[] AtxmegaStages =
    [
        (UpdateStage.Connect, "Connect to the device"),
        (UpdateStage.Check, "Check the firmware supports it"),
        (UpdateStage.Reset, "Restart it into the bootloader"),
        (UpdateStage.Bootloader, "Connect to the bootloader"),
        (UpdateStage.Write, "Write the firmware"),
        (UpdateStage.Restart, "Start the new firmware")
    ];

    static readonly (UpdateStage Stage, string Label)[] PicoStages =
    [
        (UpdateStage.Connect, "Connect to the device"),
        (UpdateStage.Check, "Check the firmware supports it"),
        (UpdateStage.Reset, "Restart it in BOOTSEL mode"),
        (UpdateStage.Bootloader, "Connect to the boot ROM"),
        (UpdateStage.Write, "Write and verify the firmware"),
        (UpdateStage.Restart, "Start the new firmware")
    ];

    (UpdateStage Stage, string Label)[] Stages => firmware?.Core == FirmwareCore.Pico ? PicoStages : AtxmegaStages;

    FirmwareFile? firmware;
    string? fileError;
    (string Name, byte[] Contents)? unnamedFile;
    bool recovery;
    bool bootselMode;
    bool showSetupHelp;
    TaskCompletionSource<WebUsbDevice?>? bootselPrompt;
    string? updatedDevice;
    bool confirmed;
    bool overrideCheck;
    bool updating;
    UpdateProgress? progress;
    string? result;
    bool resultError;

    bool DeviceReady => Session.IsConnected || (recovery && Session.Port is not null) || bootselMode;

    int CurrentStep =>
        updating || result is not null ? 4 :
        !DeviceReady ? 1 :
        firmware is null ? 2 : 3;

    Fit Compatibility =>
        firmware is null || !Session.IsConnected || Session.Identity is null ? Fit.Unchecked :
        firmware.Metadata is not { } metadata ? Fit.UnknownFile :
        metadata.Supports(Session.Identity.DeviceName ?? "", Session.Identity.HardwareVersion) ? Fit.Supported : Fit.Unsupported;

    bool CanStart => firmware is not null && confirmed && (Compatibility != Fit.Unsupported || overrideCheck);

    string? VersionNote
    {
        get
        {
            if (firmware is null || Session.Identity?.FirmwareVersion is not { } installed || Compatibility != Fit.Supported)
                return null;
            var comparison = firmware.Metadata!.FirmwareVersion.CompareTo(installed);
            return comparison == 0 ? "This version is already installed; updating reinstalls it."
                : comparison < 0 ? "This is an older version than the one installed."
                : null;
        }
    }

    bool Succeeded => result is not null && !resultError;

    string StepClass(int step) =>
        step < CurrentStep || (step == 4 && Succeeded) ? "done" : step == CurrentStep ? "current" : "upcoming";

    MarkupString StepMarker(int step) =>
        step < CurrentStep || (step == 4 && Succeeded) ? Icons.CheckMark : new MarkupString(step.ToString());

    string StageClass(UpdateStage stage)
    {
        if (progress is not { } current)
            return "pending";
        if (stage < current.Stage || (stage == current.Stage && result is not null && !resultError))
            return "done";
        if (stage == current.Stage)
            return resultError ? "failed" : "active";
        return "pending";
    }

    protected override void OnInitialized() => Session.Changed += OnChanged;

    void OnChanged() => InvokeAsync(StateHasChanged);

    async Task ChangeDeviceAsync()
    {
        recovery = false;
        bootselMode = false;
        confirmed = false;
        await Session.DisconnectAsync();
    }

    void EnterBootselMode()
    {
        bootselMode = true;
        recovery = false;
        if (firmware is not null and not PicoFirmwareFile)
            ClearFile();
    }

    void ClearFile()
    {
        firmware = null;
        confirmed = false;
        overrideCheck = false;
    }

    async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        ClearFile();
        fileError = null;
        unnamedFile = null;
        byte[] contents;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = e.File.OpenReadStream(MaxFileSize))
            {
                await stream.CopyToAsync(buffer);
            }
            contents = buffer.ToArray();
        }
        catch (IOException ex)
        {
            fileError = $"{e.File.Name} could not be read. {ex.Message}";
            return;
        }

        ReadFile(e.File.Name, contents, allowUnknownName: false);
    }

    // Installs a valid image whose name does not follow the Harp convention, at the user's request.
    void UseUnnamedFile()
    {
        if (unnamedFile is not { } file)
            return;
        unnamedFile = null;
        ReadFile(file.Name, file.Contents, allowUnknownName: true);
    }

    void ReadFile(string name, byte[] contents, bool allowUnknownName)
    {
        fileError = null;
        FirmwareFile file;
        try
        {
            file = FirmwareFile.Read(name, new MemoryStream(contents), allowUnknownName);
        }
        catch (FirmwareNameException ex)
        {
            fileError = $"{name}: {ex.Message}";
            unnamedFile = (name, contents);
            return;
        }
        catch (Exception ex) when (ex is ArgumentException or FormatException or NotSupportedException)
        {
            fileError = $"{name} is not a Harp firmware file. {ex.Message}";
            return;
        }

        if (file is PicoFirmwareFile && !Session.IsUsbSupported)
        {
            fileError = $"{name} is for a Pico device, which this browser cannot update: it has no WebUSB. Use Chrome or Edge on a desktop computer.";
            return;
        }
        if (bootselMode && file is not PicoFirmwareFile)
        {
            fileError = $"{name} is for an ATxmega device. A device in BOOTSEL mode takes a .uf2 file.";
            return;
        }
        firmware = file;
    }

    async Task UpdateAsync()
    {
        if (firmware is null || !CanStart)
            return;

        // The update takes over the connection, so remember which device it is for.
        updatedDevice = Session.Identity is { } device && Session.IsConnected
            ? $"{device.DisplayName} · firmware {device.FirmwareVersion} · hardware {device.HardwareVersion}"
            : bootselMode ? "Device in BOOTSEL mode"
            : $"{Session.PortLabel} · in its bootloader";
        updating = true;
        result = null;
        resultError = false;
        showSetupHelp = false;
        progress = new UpdateProgress(UpdateStage.Connect, 0);
        var reporter = new Progress<UpdateProgress>(value =>
        {
            progress = value;
            StateHasChanged();
        });

        // Skip the device check when the user overrode it, or when the device could not connect.
        var force = overrideCheck || !Session.IsConnected;
        try
        {
            switch (firmware)
            {
                case AtxmegaFirmwareFile atxmega:
                    await Session.RunExclusiveAsync(
                        port => AtxmegaBootloader.UpdateFirmwareAsync(port, atxmega, force, reporter),
                        reconnectDelay: TimeSpan.FromSeconds(1));
                    break;
                case PicoFirmwareFile pico when bootselMode:
                    await PicoBootRom.UpdateFirmwareAsync(null, pico, forceUpdate: true, CreateConnector(), reporter);
                    break;
                case PicoFirmwareFile pico:
                    await Session.RunExclusiveAsync(
                        port => PicoBootRom.UpdateFirmwareAsync(port, pico, force, CreateConnector(), reporter),
                        reconnectDelay: TimeSpan.FromSeconds(2),
                        portMayMove: true);
                    break;
            }

            result = Session.IsConnected && Session.Identity is { } identity
                ? $"Updated. {identity.DisplayName} now reports firmware {identity.FirmwareVersion}."
                : bootselMode
                ? "Updated. The device restarts with the new firmware: select its serial port to connect to it."
                : firmware.Core == FirmwareCore.Pico
                ? "Updated, but the device did not reconnect. Its serial port can come back as a new port: select it to check the version."
                : "Updated, but the device did not reconnect. Unplug it, plug it back in and connect to check the version.";
            recovery = false;
            bootselMode = false;
        }
        catch (Exception ex) when (ex is HarpException or TimeoutException or IOException or InvalidOperationException or NotSupportedException or ArgumentException)
        {
            resultError = true;
            result = $"The update failed: {ex.Message} {DescribeRecovery(ex)}";
            showSetupHelp = firmware.Core == FirmwareCore.Pico && BootselSetupHelp.IsNeeded &&
                (ex is BootselAccessException || (ex is BootselNotFoundException && UsbDevices.IsWindows));
        }
        finally
        {
            updating = false;
            bootselPrompt = null;
        }
    }

    string DescribeRecovery(Exception ex) => firmware?.Core switch
    {
        FirmwareCore.Pico => ex switch
        {
            UnsupportedImageException or BootselRequestIgnoredException or AmbiguousBootselDeviceException => "",
            BootselAccessException => "The device is waiting in BOOTSEL mode with its previous firmware. Give the browser access to it as described below, then choose \"Update a device in BOOTSEL mode\".",
            BootselNotFoundException => "If the device did not appear in the list, it may still be in BOOTSEL mode with its previous firmware, showing up as a USB drive. " +
                (UsbDevices.IsWindows ? "On Windows, an RP2040 appears only once the WinUSB driver is installed, as described below. " : "") +
                "Then choose \"Update a device in BOOTSEL mode\".",
            _ => "If the device stopped answering, it is waiting in BOOTSEL mode, showing up as a USB drive: choose \"Update a device in BOOTSEL mode\"."
        },
        _ => "If the device stopped answering, it is waiting in its bootloader: try again, and choose \"Update it anyway\" if it cannot connect."
    };

    WebUsbBootselConnector CreateConnector() => new(RequestBootselDeviceAsync);

    // Called by the connector when no device the page may open without asking appeared in BOOTSEL
    // mode. The browser shows its device chooser only in response to a click, so ask the user.
    async Task<WebUsbDevice?> RequestBootselDeviceAsync()
    {
        var prompt = new TaskCompletionSource<WebUsbDevice?>(TaskCreationOptions.RunContinuationsAsynchronously);
        bootselPrompt = prompt;
        await InvokeAsync(StateHasChanged);
        try
        {
            return await prompt.Task;
        }
        finally
        {
            bootselPrompt = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task SelectBootselDeviceAsync()
    {
        if (bootselPrompt is not { } prompt)
            return;
        try
        {
            var device = await UsbDevices.RequestDeviceAsync(WebUsbBootselConnector.Filters);
            if (device is not null)
                prompt.TrySetResult(device);
        }
        catch (Exception ex)
        {
            prompt.TrySetException(new IOException($"The device could not be selected. {ex.Message}", ex));
        }
    }

    void Retry()
    {
        result = null;
        progress = null;
        confirmed = false;
        showSetupHelp = false;
        if (!Session.IsConnected)
        {
            // A Pico device that failed after its reset waits in BOOTSEL mode, with no serial port.
            if (firmware is PicoFirmwareFile && Session.IsUsbSupported)
                bootselMode = true;
            else
                recovery = true;
        }
    }

    void StartOver()
    {
        result = null;
        progress = null;
        recovery = false;
        bootselMode = false;
        showSetupHelp = false;
        ClearFile();
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
