<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep real exception messages: generator failures are shown to users. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- Bump this to pick up new generator releases: https://www.nuget.org/packages/Harp.Generators -->
  <PropertyGroup>
    <HarpGeneratorsVersion>0.9.1</HarpGeneratorsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Harp.Generators" Version="$(HarpGeneratorsVersion)" />
    <!-- Firmware image parsing. Its serial port and libusb code is not used, since it cannot run in the browser. -->
    <PackageReference Include="Harp.Toolkit.Core" Version="0.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harp.WebSerial\Harp.WebSerial.csproj" />
    <ProjectReference Include="..\Harp.WebUsb\Harp.WebUsb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Harp.Generators" />
  </ItemGroup>

  <!-- YamlDotNet deserializes device metadata through reflection, so keep these from being trimmed. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Harp.Generators" />
    <TrimmerRootAssembly Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HarpGeneratorsVersion</_Parameter1>
      <_Parameter2>$(HarpGeneratorsVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
